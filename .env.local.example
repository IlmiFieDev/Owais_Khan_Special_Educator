# Supabase — get these from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Authorised admin user UUID from Supabase Auth
OWNER_USER_ID=

# Resend — https://resend.com (optional notifications)
RESEND_API_KEY=

# Cloudflare Turnstile — https://dash.cloudflare.com (optional spam protection)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Notification recipients (optional)
OWNER_EMAIL=
OWNER_WHATSAPP=

# Public site URL used for sitemap, canonical URLs and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
